%% =========================================================
%% FLUJO PRINCIPAL
%% =========================================================

NOTEBOOK --> GAME
GAME --> FIT
GAME --> AP

NOTEBOOK --> PANEL

PANEL --> DAMAGE
PANEL --> TMC
PANEL --> MONO
PANEL --> RES
PANEL --> POWER
PANEL --> TRIVIAL
PANEL --> GATE

DAMAGE --> FIT
DAMAGE --> AP

POWER --> EVAL
POWER --> BOOT

BOOT --> AP
BOOT --> AUC

NOTEBOOK --> CLOSE
CLOSE --> EVAL
CLOSE --> BOOT

EVAL --> FIT
EVAL --> AP
EVAL --> AUC


%% =========================================================
%% SHAPLEY
%% =========================================================

NOTEBOOK --> SHAP
NOTEBOOK --> TMC

SHAP -.-> V["v(S)"]
TMC -.-> V


%% =========================================================
%% FUNCIONES ESPECÍFICAS
%% =========================================================

NOTEBOOK --> CORRUPT
NOTEBOOK --> STABILITY
NOTEBOOK --> BUDGET

LOADERS --> META


